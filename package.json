{
  "name": "branchcraft",
  "version": "1.0.0",
  "description": "本地 Git 可视化桌面工作台",
  "main": "main.js",
  "author": "Branchcraft",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/git-service.test.js test/platform.test.js test/file-tree.test.js test/project-service.test.js test/terminal-service.test.js test/recovery-store.test.js test/repo-watcher.test.js",
    "pack": "node scripts/build.cjs --dir",
    "dist": "node scripts/build.cjs --publish never",
    "test:desktop": "node test/desktop-smoke.cjs",
    "dist:win": "node scripts/build.cjs --win --x64 --publish never",
    "dist:linux": "node scripts/build.cjs --linux --x64 --publish never",
    "dist:mac": "node scripts/build.cjs --mac --publish never",
    "postinstall": "node scripts/install-native.cjs",
    "test:terminal": "node test/terminal-smoke.cjs"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.branchcraft.desktop",
    "productName": "Branchcraft",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "git-service.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json",
      "platform.js",
      "file-tree.js",
      "project-service.js",
      "project-ui.js",
      "terminal-service.js",
      "terminal-ui.js",
      "recovery-store.js",
      "repo-watcher.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "MannixYang"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MannixYang/Branchcraft.git"
  },
  "bugs": {
    "url": "https://github.com/MannixYang/Branchcraft/issues"
  },
  "homepage": "https://github.com/MannixYang/Branchcraft",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
